      "name": "IF role is 'admin'"
    },
    {
      "parameters": {
        "jsCode": "const chat_id =\n  $json?.meta?.chat_id ??\n  $json?.chat_id ??\n  null;\n\nconst reply_text = \"⛔ Admin only.\";\n\nreturn [{\n  json: {\n    ...$json,\n    ok: false,\n    code: \"ADMIN_ONLY\",\n    chat_id,\n    output: {\n      ...( $json.output ?? {} ),\n      reply_text,\n    },\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        192,
        368
      ],
      "id": "d20547a9-bbcc-400c-8c69-4cab3fa901c3",
      "name": "Return admin only"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require(\"crypto\");\n\n// raw token (что покажем пользователю)\nconst token = crypto.randomBytes(24).toString(\"hex\"); // 48 hex chars\n\n// hash token (что будем хранить в БД)\nconst token_hash = crypto.createHash(\"sha256\").update(token).digest(\"hex\");\n\nreturn [{\n  json: {\n    ...$json,\n    token,\n    token_hash,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        192,
        144
      ],
      "id": "0a611d57-ef89-4f5c-8c19-ad3b85cb102d",
      "name": "Make token"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into public.demo_invites (token, expires_at)\nvalues ($1, now() + interval '7 days')\nreturning token, expires_at;",
        "options": {
          "queryReplacement": "={{$json.token}}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        368,
        0
      ],
      "id": "a4594cc9-fbf4-4ad9-af8b-5cdff20aaee1",
      "name": "Insert invite",
      "credentials": {
        "postgres": {
          "id": "qs9FA0xQaKSneWtC",
          "name": "RAG Assistant DB"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const chat_id =\n  $json?.meta?.chat_id ??\n  $json?.chat_id ??\n  null;\n\nconst token = $json.token;\n\nconst reply_text = `✅ Invite token (valid 7 days)\\nSend:\\n/start ${token}`;\n\nreturn [{\n  json: {\n    ...$json,\n    ok: true,\n    code: \"OK\",\n    chat_id,\n    output: {\n      ...( $json.output ?? {} ),\n      reply_text,\n    },\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        144
      ],
      "id": "daffbe1b-bc26-4894-8ffd-d52650346bc6",
      "name": "Build reply"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select role\nfrom public.allowed_chats\nwhere chat_id = $1\n  and is_active = true\n  and (expires_at is null or expires_at > now())\nlimit 1;\n",
        "options": {
          "queryReplacement": "={{$json.meta.chat_id}}"
        }
