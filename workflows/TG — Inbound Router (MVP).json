      "parameters": {
        "jsCode": "// n8n Code node: Build reply for /debug (last turn)\n\nconst r = $json || {};\n\n// ts может называться created_at (timestamptz)\nconst t = r.created_at ?? r.ts ?? \"-\";\nconst trace = r.trace_id ?? \"-\";\n\nconst q = r.question ?? \"-\";\nconst a = r.answer ?? \"-\";\n\nconst fallbackType = r.fallback_type ?? \"-\";\nconst topScore = r.top_score ?? '-';\nconst latencyMs = r.latency_ms ?? '-';\nconst promptVersion = r.prompt_version ?? '-';\nconst model = r.model ?? '-';\n\n// (опционально) sources_json красиво показать\nlet sourcesLine = \"\";\ntry {\n  const sj = r.sources_json;\n  if (sj && typeof sj === \"object\") {\n    // пример: если у тебя там hits или sources — подстрой под свой формат\n    // сейчас просто покажем kb_ref если он там есть\n    const kbRef =\n      sj?.kb_ref ??\n      sj?.retrieval?.kb_ref ??\n      sj?.decision?.kb_ref ??\n      null;\n    if (kbRef) sourcesLine = `\\nkb_ref: ${kbRef}`;\n  }\n} catch {}\n\nconst reply =\n`DEBUG (last turn)\n\nt: ${t}\ntrace: ${trace}\n\nq: ${q}\n\na: ${a}\n\nfallback_type: ${fallbackType}\ntop_score: ${topScore}\nlatency_ms: ${latencyMs}\nprompt_version: ${promptVersion}\nmodel: ${model}${sourcesLine}`;\n\nreturn [{\n  json: {\n    ...r,\n    output: {\n      ...(r.output ?? {}),\n      reply_text: reply,\n    },\n  },\n}];"
      },
