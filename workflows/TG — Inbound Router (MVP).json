    {
      "parameters": {
        "jsCode": "const j = $json ?? {};\nconst chat_id = Number(j.telegram?.message?.chat?.id ?? j.meta?.chat_id ?? j.chat_id ?? 0);\n\n// только твой приватный чат для демо (замени/добавь нужные id)\nconst DEMO_CHAT_IDS = new Set([168487641]);\n\nconst forced = DEMO_CHAT_IDS.has(chat_id) ? \"ceo_x_demo\" : null;\nconst kb_ref = forced ?? (j.kb_ref ?? j.meta?.kb_ref ?? null);\n\nreturn [{\n  json: {\n    ...j,\n    kb_ref,\n    meta: {\n      ...(j.meta ?? {}),\n      kb_ref,\n      chat_id: Number.isFinite(chat_id) ? chat_id : (j.meta?.chat_id ?? null),\n    },\n  }\n}];\n"
