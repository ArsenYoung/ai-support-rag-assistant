        "query": "select\n  regexp_replace(trim(lower(kb_ref)), '[-\\s]+', '_', 'g') as source,\n  count(*) as chunks\nfrom public.kb_chunks\ngroup by 1\norder by chunks desc\nlimit 30;",
        "options": {}
