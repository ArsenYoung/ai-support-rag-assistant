    {
      "parameters": {
        "jsCode": "const j = $json ?? {};\n\nfunction genId() {\n  if (globalThis.crypto?.randomUUID) return globalThis.crypto.randomUUID();\n  return `rid_${Date.now()}_${Math.random().toString(16).slice(2)}`;\n}\n\nfunction isObj(x) {\n  return x !== null && typeof x === \"object\" && !Array.isArray(x);\n}\n\nconst meta = isObj(j.meta) ? j.meta : {};\nconst request_id = meta.request_id ?? j.request_id ?? genId();\nconst trace_id = j.trace_id ?? meta.trace_id ?? meta.request_id ?? request_id;\n\nconst telegram = isObj(j.telegram) ? j.telegram : {};\nconst input = isObj(j.input) ? j.input : {};\nconst output = isObj(j.output) ? j.output : {};\n\n// Telegram message/callback extraction\nconst tgMsg =\n  telegram.message ??\n  telegram.callback_query?.message ??\n  {}; // may be {}\n\nconst tgFrom =\n  telegram.message?.from ??\n  telegram.callback_query?.from ??\n  null;\n\n// IDs (cover all known shapes)\nconst chat_id =\n  j.chat_id ??\n  j.tg_chat_id ??\n  input.chat_id ??\n  input.tg_chat_id ??\n  telegram.chat?.id ??\n  telegram.message?.chat?.id ??\n  telegram.callback_query?.message?.chat?.id ??\n  tgMsg.chat?.id ??\n  null;\n\nconst user_id =\n  j.user_id ??\n  j.tg_user_id ??\n  input.user_id ??\n  input.tg_user_id ??\n  telegram.from?.id ??\n  telegram.message?.from?.id ??\n  telegram.callback_query?.from?.id ??\n  tgFrom?.id ??\n  null;\n\n// Question / Reply text (always strings)\nconst questionRaw =\n  input.question ??\n  input.text ??\n  j.question ??\n  j.text ??\n  tgMsg.text ??\n  telegram.callback_query?.data ??\n  \"\";\n\nconst replyTextRaw =\n  output.reply_text ??\n  output.reply ??\n  j.reply_text ??\n  j.reply ??\n  j.answer ??\n  output.answer ??\n  \"\";\n\nconst question = String(questionRaw ?? \"\");\nconst reply_text = String(replyTextRaw ?? \"\");\n\nreturn [{\n  json: {\n    trace_id,\n    chat_id: chat_id == null ? null : String(chat_id),\n    user_id: user_id == null ? null : String(user_id),\n\n    meta: { ...meta, request_id },\n\n    input: { ...input, question },\n    telegram,\n\n    decision: j.decision ?? null,\n    output: { ...output, reply_text },\n\n    retrieval: j.retrieval ?? null,\n    timers: j.timers ?? null,\n    error: j.error ?? null,\n\n    channel: j.channel ?? meta.channel ?? \"unknown\",\n  }\n}];"
      },
