    {
      "parameters": {
        "jsCode": "// Cmd — Sources (Build Reply)\n\n// 1) База — текущий инпут (он уже содержит meta/chat_id и т.д.)\nconst base = $json ?? {};\n\n// 2) Rows из БД: если нода стоит после SQL, то items = строки.\n// Но если перед ней был Merge, иногда rows лежат в другом поле.\n// Делаем максимально безопасно:\nconst rows = (Array.isArray(items) ? items : [])\n  .map(i => i?.json)\n  .filter(Boolean);\n\n// 3) Формируем список\nconst list = rows.slice(0, 30).map((r, idx) => {\n  const name =\n    r.source ??\n    r.kb_ref ??\n    r.doc ??\n    r.source_url ??\n    'unknown';\n\n  const chunks = r.chunks ?? r.chunk_ids ?? r.chunk_count ?? '';\n  const suffix = chunks ? ` (${chunks})` : '';\n  return `${idx + 1}) ${name}${suffix}`;\n});\n\n// 4) Текст ответа\nconst reply_text =\n  list.length\n    ? `Sources:\\n${list.join('\\n')}`\n    : 'No sources yet.';\n\n// 5) ВАЖНО: n8n ждёт { json: ... }\nreturn [{\n  json: {\n    ...base,\n    output: {\n      ...(base.output ?? {}),\n      reply_text,\n    },\n    chat_id:\n      base.chat_id ??\n      base.meta?.chat_id ??\n      base.telegram?.message?.chat?.id ??\n      null,\n  }\n}];\n"
      },
